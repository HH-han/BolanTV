# MoonTVPlus 环境变量配置文件示例
# 复制此文件为 .env 并填写实际值

# ============================================
# 必填配置 - 访问控制
# ============================================
# 站长账号（必填）
USERNAME=admin

# 站长密码（必填）- 请设置强密码以启用访问控制
PASSWORD=your_secure_password_here

# ============================================
# 存储配置（必填）
# ============================================
# 存储类型: localstorage, redis, kvrocks, upstash, d1
NEXT_PUBLIC_STORAGE_TYPE=localstorage

# Redis 配置（当 STORAGE_TYPE=redis 时使用）
REDIS_URL=redis://localhost:6379

# Kvrocks 配置（当 STORAGE_TYPE=kvrocks 时使用）
KVROCKS_URL=redis://localhost:6666

# Upstash 配置（当 STORAGE_TYPE=upstash 时使用）
UPSTASH_URL=https://xxx.upstash.io
UPSTASH_TOKEN=your_upstash_token

# D1 数据库 ID（当 STORAGE_TYPE=d1 时使用）
D1_DATABASE_ID=your_d1_database_id

# ============================================
# 站点配置（可选）
# ============================================
# 站点名称
NEXT_PUBLIC_SITE_NAME=BolanTV

# 站点公告
ANNOUNCEMENT=本网站仅提供影视信息搜索服务，所有内容均来自第三方网站。本站不存储任何视频资源，不对任何内容的准确性、合法性、完整性负责。

# 站点 URL
SITE_BASE=https://your-domain.com

# ============================================
# 功能配置（可选）
# ============================================
# 搜索最大页数（1-50）
NEXT_PUBLIC_SEARCH_MAX_PAGE=5

# 豆瓣代理类型
NEXT_PUBLIC_DOUBAN_PROXY_TYPE=cmliussss-cdn-tencent

# 豆瓣代理 URL
NEXT_PUBLIC_DOUBAN_PROXY=

# 豆瓣图片代理类型
NEXT_PUBLIC_DOUBAN_IMAGE_PROXY_TYPE=cmliussss-cdn-tencent

# 豆瓣图片代理 URL
NEXT_PUBLIC_DOUBAN_IMAGE_PROXY=

# 关闭色情内容过滤
NEXT_PUBLIC_DISABLE_YELLOW_FILTER=false

# 开启搜索接口流式输出
NEXT_PUBLIC_FLUID_SEARCH=true

# M3U8 代理 API 鉴权 Token
NEXT_PUBLIC_PROXY_M3U8_TOKEN=

# 弹幕缓存失效时间（分钟，0 为不缓存）
NEXT_PUBLIC_DANMAKU_CACHE_EXPIRE_MINUTES=4320

# 观影室语音聊天策略
NEXT_PUBLIC_VOICE_CHAT_STRATEGY=webrtc-fallback

# 启用服务器离线下载功能
NEXT_PUBLIC_ENABLE_OFFLINE_DOWNLOAD=false

# 离线下载文件存储目录
OFFLINE_DOWNLOAD_DIR=/data

# 启用源站寻片功能
NEXT_PUBLIC_ENABLE_SOURCE_SEARCH=true

# ============================================
# 定时任务配置（可选）
# ============================================
# 定时任务 API 访问密码
CRON_PASSWORD=mtvpls

# ============================================
# 弹幕配置（可选）
# ============================================
# 弹幕 API 地址
DANMAKU_API_BASE=http://localhost:9321

# 弹幕 API Token
DANMAKU_API_TOKEN=87654321

# ============================================
# TMDB 配置（可选）
# ============================================
# TMDB API 密钥
TMDB_API_KEY=

# TMDB 代理
TMDB_PROXY=

# TMDB 反向代理
TMDB_REVERSE_PROXY=

# ============================================
# TVBOX 订阅配置（可选）
# ============================================
# 启用 TVBOX 订阅功能
ENABLE_TVBOX_SUBSCRIBE=false

# TVBOX 订阅 API 访问 Token
TVBOX_SUBSCRIBE_TOKEN=

# TVBOX 订阅屏蔽源列表
TVBOX_BLOCKED_SOURCES=

# ============================================
# 观影室配置（可选）
# ============================================
# 启用观影室功能
WATCH_ROOM_ENABLED=false

# 观影室服务器类型
WATCH_ROOM_SERVER_TYPE=internal

# 外部观影室服务器地址
WATCH_ROOM_EXTERNAL_SERVER_URL=

# 外部观影室服务器认证令牌
WATCH_ROOM_EXTERNAL_SERVER_AUTH=

# ============================================
# 初始化配置（可选）
# ============================================
# 初始配置（JSON 格式）
INIT_CONFIG=

# 配置订阅 URL
CONFIG_SUBSCRIPTION_URL=
