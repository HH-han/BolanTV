<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="设置服务器地址"
        android:textColor="@color/gray_light"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="请输入 MoonTVPlus 服务端地址\n例如 http://192.168.1.10:3000"
        android:textColor="#9ca3af"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/server_url_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:background="@color/gray_dark"
        android:hint="http://192.168.1.10:3000"
        android:imeOptions="actionDone"
        android:inputType="textUri"
        android:padding="14dp"
        android:textColor="@color/gray_light"
        android:textColorHint="#6b7280"
        android:textSize="16sp" />

    <Button
        android:id="@+id/server_url_confirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/accent"
        android:text="确认并进入"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
